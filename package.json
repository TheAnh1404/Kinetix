{
  "name": "kinetix",
  "version": "1.0.0",
  "description": "The Multi-Generational Family Finance OS on Avalanche",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -n \"FRONTEND,BACKEND,WORKER\" -c \"cyan.bold,green.bold,yellow.bold\" \"npm run dev:frontend\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:server": "tsx watch backend/src/server.ts",
    "dev:worker": "tsx watch backend/src/workers/eventListener.ts",
    "compile": "hardhat compile",
    "check:testnet": "node -r ts-node/register/transpile-only scripts/check-testnet.ts",
    "test": "hardhat test",
    "sol:format": "prettier --write \"contracts/**/*.sol\"",
    "sol:lint": "solhint \"contracts/**/*.sol\"",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "deploy:familyL1": "hardhat run scripts/deploy.ts --network familyL1",
    "db:generate": "drizzle-kit generate --config=backend/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=backend/drizzle.config.ts",
    "db:migrate": "node -r ts-node/register/transpile-only backend/src/db/migrate.ts",
    "db:check": "node -r ts-node/register/transpile-only scripts/check-db-schema.ts",
    "db:migrate:member": "node -r ts-node/register/transpile-only backend/src/db/migrate.ts --member-upgrade",
    "db:seed": "tsx backend/src/db/seed.ts",
    "db:clear": "tsx scripts/clear-db.ts",
    "db:studio": "drizzle-kit studio --config=backend/drizzle.config.ts",
    "server:start": "tsx backend/src/server.ts",
    "worker:listen": "tsx backend/src/workers/eventListener.ts",
    "test:auth": "node scripts/run-auth-tests.cjs",
    "test:auth:integration": "node scripts/run-auth-tests.cjs --integration",
    "test:v2:integration": "node -r ts-node/register/transpile-only scripts/verify-v2-integration.ts",
    "test:auth:local": "node scripts/run-local-postgres-tests.cjs",
    "test:v2:local": "node scripts/run-local-postgres-tests.cjs --v2",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "avalanche",
    "hackathon",
    "teleporter",
    "multisig",
    "solidity",
    "drizzle",
    "neon",
    "viem"
  ],
  "author": "Kinetix Solo Builder",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "viem": "^2.9.23",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "^4.3.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.21.4",
    "hardhat": "^2.22.3",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "solc": "0.8.26"
  },
  "engines": {
    "node": ">=24.7.0"
  }
}
