# ==============================================================================
# Kinetix Docker Compose Environment Configuration Template
# Sao chép file này thành .env hoặc dùng trực tiếp khi chạy:
# docker compose --env-file .env.docker up -d
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=kinetix
POSTGRES_PASSWORD=kinetix_secret_123
POSTGRES_DB=kinetix_db

# Security & Authentication
JWT_SECRET=kinetix_production_ready_jwt_secret_token_key_change_me!
APP_ORIGIN=http://localhost:3000

# Avalanche Blockchain Configuration
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113
