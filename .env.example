# =================================================================
# KINETIX - THE MULTI-GENERATIONAL FAMILY FINANCE OS ON AVALANCHE
# =================================================================

# 1. Neon Serverless PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# 2. Private key xuất từ ví Avalanche Core Wallet (chứa AVAX testnet nhận từ Fuji Faucet)
# LƯU Ý: Không commit file .env thật chứa private key lên Git
CORE_WALLET_PRIVATE_KEY=your_avalanche_core_wallet_private_key_here

# 3. Cấu hình Avalanche Fuji C-Chain
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113

# 4. Cấu hình Family L1 (Custom Avalanche L1 / Subnet)
FAMILY_L1_RPC_URL=http://127.0.0.1:9650/ext/bc/FamilyL1/rpc
FAMILY_L1_CHAIN_ID=99999

# 5. Địa chỉ hợp đồng sau khi triển khai
FAMILY_HUB_ADDRESS=
FAMILY_YIELD_VAULT_ADDRESS=

# 6. Địa chỉ Avalanche Teleporter Messenger chính thức trên Fuji Testnet
TELEPORTER_MESSENGER_FUJI=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf

# 7. Backend Server Port
PORT=4000

# Authentication / same-origin BFF. No trailing slash.
APP_ORIGIN=http://localhost:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# Native Argon2id requires Node >=24.7. Sessions use random opaque tokens; JWT is retired.
# Set HUB_CHAIN_ID/HUB_RPC_URL to the actual network hosting FamilyHub.
HUB_CHAIN_ID=43113
HUB_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYMENT_MANIFEST=shared/deployment.json
# Manifest is the public source of chain, contracts, deployment receipts and features.
# T1: native AVAX only; bridge, ERC20, yield and sponsored relayer remain disabled.
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
DEPLOY_MAX_FEE_GWEI=50
# Test commands refuse to use DATABASE_URL; supply an isolated disposable database.
TEST_DATABASE_URL=
AUTH_TEST_ALLOW_RESET=false
TRUST_PROXY_HOPS=0

# Optional signed client-IP forwarding for per-IP rate limits behind the BFF.
# Generate a random >=32-character value, identical in backend and frontend environments.
# Without it, limits conservatively use the API peer IP.
BFF_SHARED_SECRET=
# Enable only when your trusted frontend proxy OVERWRITES x-real-ip.
BFF_TRUST_PROXY_IP_HEADER=false
AUTH_SEED_ALLOW_RESET=false
# Presentation gate only. Apply migration 0009 before enabling/restarting the new API.
# Setting false never skips mandatory password/wallet activation.
START_SCREEN_ENABLED=true
# Enable only if TransactionAllowList is activated in this L1's genesis/upgrade config.
# When true, receipts are confirmed only after readAllowList(wallet) > 0; client checks it too.
TX_ALLOWLIST_ENABLED=false

# Khối triển khai Hub để worker quét lịch sử cá nhân; 0 quét từ đầu theo lô 1000 block.
# Chỉ đặt khối triển khai thật; đặt quá muộn sẽ bỏ qua lịch sử trước đó.
HUB_ACTIVITY_START_BLOCK=0
